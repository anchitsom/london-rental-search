<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.anchitsom.openrent-adhoc</string>

  <key>ProgramArguments</key>
  <array>
    <string>/path/to/london-rental-engine/scripts/openrent-adhoc-run.sh</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/path/to/london-rental-engine</string>

  <key>RunAtLoad</key>
  <false/>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/path/to/london-rental-engine/.venv/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
  </dict>

  <key>StandardOutPath</key>
  <string>/path/to/london-rental-engine/logs/openrent-adhoc.log</string>
  <key>StandardErrorPath</key>
  <string>/path/to/london-rental-engine/logs/openrent-adhoc.log</string>
</dict>
</plist>
