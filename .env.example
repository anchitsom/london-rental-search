# London Rental Engine - environment template
# Copy to .env and fill in. Never commit the real .env.

# EPC Open Data Communities (free): https://epc.opendatacommunities.org/
EPC_EMAIL=you@example.com
EPC_API_KEY=your-epc-api-key

# TfL (free): https://api-portal.tfl.gov.uk/
TFL_APP_KEY=your-tfl-app-key
TFL_DESTINATION=Old Street Station, London

# Local Ollama vision model
OLLAMA_URL=http://127.0.0.1:11434
VISION_MODEL=qwen3-vl:2b-instruct-q8_0

# Pipeline behaviour
ENABLED_PORTALS=rightmove,zoopla,openrent
ALERT_THRESHOLD=60
FRESHNESS_HOURS=23

# Paths (defaults are sensible; override only if needed)
HOMEHUNT_DB=data/homehunt.db
HOMEHUNT_CONFIG=london-search.yaml
